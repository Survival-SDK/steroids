                ffi.cast("st_object_t *", self.handle).funcs
            ).get_singleton(self.handle, subsystem, module_name), false)
        end,
    }, { __index = Object.methods })

    M.__mt = ffi.metatype("struct { st_modsmgr_t *handle; bool owned; }", {
        __index = M.methods,
