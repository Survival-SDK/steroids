package.preload["KeyboardCtx"] = function()
    local ffi = require "ffi"

    local ModCtx  = require "ModCtx"
    local ModsMgr = require "ModsMgr"
    local Object  = require "Object"

    ffi.cdef[[
        typedef struct st_keyboardctx {
            st_modctx_t __st_parent;
        } st_keyboardctx_t;

        typedef enum {
            ST_KEY_UNKNOWN       = 0x0000,

            ST_KEY_SPACE         = 0x0020,
            ST_KEY_EXCLAM        = 0x0021,
            ST_KEY_QUOTEDBL      = 0x0022,
            ST_KEY_NUMBERSIGN    = 0x0023,
            ST_KEY_DOLLAR        = 0x0024,
            ST_KEY_PERCENT       = 0x0025,
            ST_KEY_AMPERSAND     = 0x0026,
            ST_KEY_APOSTROPHE    = 0x0027,
            ST_KEY_QUOTERIGHT    = 0x0027,
            ST_KEY_PARENLEFT     = 0x0028,
            ST_KEY_PARENRIGHT    = 0x0029,
            ST_KEY_ASTERISK      = 0x002A,
            ST_KEY_PLUS          = 0x002B,
            ST_KEY_COMMA         = 0x002C,
            ST_KEY_MINUS         = 0x002D,
            ST_KEY_PERIOD        = 0x002E,
            ST_KEY_SLASH         = 0x002F,
            ST_KEY_0             = 0x0030,
            ST_KEY_1             = 0x0031,
            ST_KEY_2             = 0x0032,
            ST_KEY_3             = 0x0033,
            ST_KEY_4             = 0x0034,
            ST_KEY_5             = 0x0035,
            ST_KEY_6             = 0x0036,
            ST_KEY_7             = 0x0037,
            ST_KEY_8             = 0x0038,
            ST_KEY_9             = 0x0039,
            ST_KEY_COLON         = 0x003A,
            ST_KEY_SEMICOLON     = 0x003B,
            ST_KEY_LESS          = 0x003C,
            ST_KEY_EQUAL         = 0x003D,
            ST_KEY_GREATER       = 0x003E,
            ST_KEY_QUESTION      = 0x003F,
            ST_KEY_AT            = 0x0040,
            ST_KEY_A             = 0x0041,
            ST_KEY_B             = 0x0042,
            ST_KEY_C             = 0x0043,
            ST_KEY_D             = 0x0044,
            ST_KEY_E             = 0x0045,
            ST_KEY_F             = 0x0046,
            ST_KEY_G             = 0x0047,
            ST_KEY_H             = 0x0048,
            ST_KEY_I             = 0x0049,
            ST_KEY_J             = 0x004A,
            ST_KEY_K             = 0x004B,
            ST_KEY_L             = 0x004C,
            ST_KEY_M             = 0x004D,
            ST_KEY_N             = 0x004E,
            ST_KEY_O             = 0x004F,
            ST_KEY_P             = 0x0050,
            ST_KEY_Q             = 0x0051,
            ST_KEY_R             = 0x0052,
            ST_KEY_S             = 0x0053,
            ST_KEY_T             = 0x0054,
            ST_KEY_U             = 0x0055,
            ST_KEY_V             = 0x0056,
            ST_KEY_W             = 0x0057,
            ST_KEY_X             = 0x0058,
            ST_KEY_Y             = 0x0059,
            ST_KEY_Z             = 0x005A,
            ST_KEY_BRACKETLEFT   = 0x005B,
            ST_KEY_BACKSLASH     = 0x005C,
            ST_KEY_BRACKETRIGHT  = 0x005D,
            ST_KEY_ASCIICIRCUM   = 0x005E,
            ST_KEY_UNDERSCORE    = 0x005F,
            ST_KEY_GRAVE         = 0x0060,
            ST_KEY_QUOTELEFT     = 0x0060,
            ST_KEY_BRACELEFT     = 0x007B,
            ST_KEY_BAR           = 0x007C,
            ST_KEY_BRACERIGHT    = 0x007D,
            ST_KEY_ASCIITILDE    = 0x007E,

            ST_KEY_BACKSPACE     = 0xFF08,
            ST_KEY_TAB           = 0xFF09,
            ST_KEY_LINEFEED      = 0xFF0a,
            ST_KEY_CLEAR         = 0xFF0B,
            ST_KEY_RETURN        = 0xFF0D,
            ST_KEY_PAUSE         = 0xFF13,
            ST_KEY_SCROLL_LOCK   = 0xFF14,
            ST_KEY_SYS_REQ       = 0xFF15,
            ST_KEY_ESCAPE        = 0xFF1B,
            ST_KEY_DELETE        = 0xFFFF,

            ST_KEY_HOME          = 0xFF50,
            ST_KEY_LEFT          = 0xFF51,
            ST_KEY_UP            = 0xFF52,
            ST_KEY_RIGHT         = 0xFF53,
            ST_KEY_DOWN          = 0xFF54,
            ST_KEY_PRIOR         = 0xFF55,
            ST_KEY_PAGE_UP       = 0xFF55,
            ST_KEY_NEXT          = 0xFF56,
            ST_KEY_PAGE_DOWN     = 0xFF56,
            ST_KEY_END           = 0xFF57,
            ST_KEY_BEGIN         = 0xFF58,

            ST_KEY_SELECT        = 0xFF60,
            ST_KEY_PRINT         = 0xFF61,
            ST_KEY_EXECUTE       = 0xFF62,
            ST_KEY_INSERT        = 0xFF63,
            ST_KEY_UNDO          = 0xFF65,
            ST_KEY_REDO          = 0xFF66,
            ST_KEY_MENU          = 0xFF67,
            ST_KEY_FIND          = 0xFF68,
            ST_KEY_CANCEL        = 0xFF69,
            ST_KEY_HELP          = 0xFF6A,
            ST_KEY_BREAK         = 0xFF6B,
            ST_KEY_MODE_SWITCH   = 0xFF7E,
            ST_KEY_SCRIPT_SWITCH = 0xFF7E,
            ST_KEY_NUM_LOCK      = 0xFF7F,

            ST_KEY_KP_SPACE      = 0xFF80,
            ST_KEY_KP_TAB        = 0xFF89,
            ST_KEY_KP_ENTER      = 0xFF8D,
            ST_KEY_KP_F1         = 0xFF91,
            ST_KEY_KP_F2         = 0xFF92,
            ST_KEY_KP_F3         = 0xFF93,
            ST_KEY_KP_F4         = 0xFF94,
            ST_KEY_KP_HOME       = 0xFF95,
            ST_KEY_KP_LEFT       = 0xFF96,
            ST_KEY_KP_UP         = 0xFF97,
            ST_KEY_KP_RIGHT      = 0xFF98,
            ST_KEY_KP_DOWN       = 0xFF99,
            ST_KEY_KP_PRIOR      = 0xFF9A,
            ST_KEY_KP_PAGE_UP    = 0xFF9A,
            ST_KEY_KP_NEXT       = 0xFF9B,
            ST_KEY_KP_PAGE_DOWN  = 0xFF9B,
            ST_KEY_KP_END        = 0xFF9C,
            ST_KEY_KP_BEGIN      = 0xFF9D,
            ST_KEY_KP_INSERT     = 0xFF9E,
            ST_KEY_KP_DELETE     = 0xFF9F,
            ST_KEY_KP_EQUAL      = 0xFFBD,
            ST_KEY_KP_MULTIPLY   = 0xFFAA,
            ST_KEY_KP_ADD        = 0xFFAB,
            ST_KEY_KP_SEPARATOR  = 0xFFAC,
            ST_KEY_KP_SUBTRACT   = 0xFFAD,
            ST_KEY_KP_DECIMAL    = 0xFFAE,
            ST_KEY_KP_DIVIDE     = 0xFFAF,

            ST_KEY_KP_0          = 0xFFB0,
            ST_KEY_KP_1          = 0xFFB1,
            ST_KEY_KP_2          = 0xFFB2,
            ST_KEY_KP_3          = 0xFFB3,
            ST_KEY_KP_4          = 0xFFB4,
            ST_KEY_KP_5          = 0xFFB5,
            ST_KEY_KP_6          = 0xFFB6,
            ST_KEY_KP_7          = 0xFFB7,
            ST_KEY_KP_8          = 0xFFB8,
            ST_KEY_KP_9          = 0xFFB9,

            ST_KEY_F1            = 0xFFBE,
            ST_KEY_F2            = 0xFFBF,
            ST_KEY_F3            = 0xFFC0,
            ST_KEY_F4            = 0xFFC1,
            ST_KEY_F5            = 0xFFC2,
            ST_KEY_F6            = 0xFFC3,
            ST_KEY_F7            = 0xFFC4,
            ST_KEY_F8            = 0xFFC5,
            ST_KEY_F9            = 0xFFC6,
            ST_KEY_F10           = 0xFFC7,
            ST_KEY_F11           = 0xFFC8,
            ST_KEY_L1            = 0xFFC8,
            ST_KEY_F12           = 0xFFC9,
            ST_KEY_L2            = 0xFFC9,
            ST_KEY_F13           = 0xFFCA,
            ST_KEY_L3            = 0xFFCA,
            ST_KEY_F14           = 0xFFCB,
            ST_KEY_L4            = 0xFFCB,
            ST_KEY_F15           = 0xFFCC,
            ST_KEY_L5            = 0xFFCC,
            ST_KEY_F16           = 0xFFCD,
            ST_KEY_L6            = 0xFFCD,
            ST_KEY_F17           = 0xFFCE,
            ST_KEY_L7            = 0xFFCE,
            ST_KEY_F18           = 0xFFCF,
            ST_KEY_L8            = 0xFFCF,
            ST_KEY_F19           = 0xFFD0,
            ST_KEY_L9            = 0xFFD0,
            ST_KEY_F20           = 0xFFD1,
            ST_KEY_L10           = 0xFFD1,
            ST_KEY_F21           = 0xFFD2,
            ST_KEY_R1            = 0xFFD2,
            ST_KEY_F22           = 0xFFD3,
            ST_KEY_R2            = 0xFFD3,
            ST_KEY_F23           = 0xFFD4,
            ST_KEY_R3            = 0xFFD4,
            ST_KEY_F24           = 0xFFD5,
            ST_KEY_R4            = 0xFFD5,
            ST_KEY_F25           = 0xFFD6,
            ST_KEY_R5            = 0xFFD6,
            ST_KEY_F26           = 0xFFD7,
            ST_KEY_R6            = 0xFFD7,
            ST_KEY_F27           = 0xFFD8,
            ST_KEY_R7            = 0xFFD8,
            ST_KEY_F28           = 0xFFD9,
            ST_KEY_R8            = 0xFFD9,
            ST_KEY_F29           = 0xFFDA,
            ST_KEY_R9            = 0xFFDA,
            ST_KEY_F30           = 0xFFDB,
            ST_KEY_R10           = 0xFFDB,
            ST_KEY_F31           = 0xFFDC,
            ST_KEY_R11           = 0xFFDC,
            ST_KEY_F32           = 0xFFDD,
            ST_KEY_R12           = 0xFFDD,
            ST_KEY_F33           = 0xFFDE,
            ST_KEY_R13           = 0xFFDE,
            ST_KEY_F34           = 0xFFDF,
            ST_KEY_R14           = 0xFFDF,
            ST_KEY_F35           = 0xFFE0,
            ST_KEY_R15           = 0xFFE0,

            ST_KEY_SHIFT_L       = 0xFFE1,
            ST_KEY_SHIFT_R       = 0xFFE2,
            ST_KEY_CONTROL_L     = 0xFFE3,
            ST_KEY_CONTROL_R     = 0xFFE4,
            ST_KEY_CAPS_LOCK     = 0xFFE5,
            ST_KEY_SHIFT_LOCK    = 0xFFE6,

            ST_KEY_META_L        = 0xFFE7,
            ST_KEY_META_R        = 0xFFE8,
            ST_KEY_ALT_L         = 0xFFE9,
            ST_KEY_ALT_R         = 0xFFEA,
            ST_KEY_SUPER_L       = 0xFFEB,
            ST_KEY_SUPER_R       = 0xFFEC,
            ST_KEY_HYPER_L       = 0xFFED,
            ST_KEY_HYPER_R       = 0xFFEE,
        } st_key_t;

        typedef void (*st_keyboard_process_t)(st_keyboardctx_t *keyboard_ctx);
        typedef bool (*st_keyboard_press_t)(const st_keyboardctx_t *keyboard_ctx,
         st_key_t key);
        typedef bool (*st_keyboard_release_t)(
         const st_keyboardctx_t *keyboard_ctx, st_key_t key);
        typedef bool (*st_keyboard_pressed_t)(
         const st_keyboardctx_t *keyboard_ctx, st_key_t key);
        typedef const char *(*st_keyboard_get_input_t)(
         const st_keyboardctx_t *keyboard_ctx);

        typedef struct {
            st_modctx_funcs_t          __st_parent_funcs;
            st_keyboard_process_t      process;
            st_keyboard_press_t        press;
            st_keyboard_release_t      release;
            st_keyboard_pressed_t      pressed;
            st_keyboard_get_input_t    get_input;
        } st_keyboardctx_funcs_t;
    ]]

    local M = {
        __ctype = "st_keyboardctx_t *",
    }

    M.methods = setmetatable({
        process = function(self)
            ffi.cast("const st_keyboardctx_funcs_t *",
                ffi.cast("st_object_t *", self.handle).funcs
            ).process(self.handle)
        end,

        press = function(self, key)
            return ffi.cast("const st_keyboardctx_funcs_t *",
                ffi.cast("st_object_t *", self.handle).funcs
            ).press(self.handle, key)
        end,

        release = function(self, key)
            return ffi.cast("const st_keyboardctx_funcs_t *",
                ffi.cast("st_object_t *", self.handle).funcs
            ).release(self.handle, key)
        end,

        pressed = function(self, key)
            return ffi.cast("const st_keyboardctx_funcs_t *",
                ffi.cast("st_object_t *", self.handle).funcs
            ).pressed(self.handle, key)
        end,

        get_input = function(self)
            local input_ptr = ffi.cast("const st_keyboardctx_funcs_t *",
                ffi.cast("st_object_t *", self.handle).funcs
            ).get_input(self.handle)
            
            if input_ptr == nil then
                return nil
            end
            
            return ffi.string(input_ptr)
        end,
    }, { __index = ModCtx.methods })

    M.__mt = ffi.metatype(
        "struct { st_keyboardctx_t *handle; bool owned; }", {
        __index = M.methods,
        __new = function(class, handle, owned)
            return ffi.new(class, handle, owned)
        end,
        __gc = function(self)
            if self.owned then
                self:destroy()
            end
        end,
    })

    M.new_by_name = function(name, ...)
        local modsmgr = ModsMgr.get_instance()

        local keyboard_ctor = modsmgr:get_ctor("keyboard", name)
        if not keyboard_ctor then
            error(string.format(
                "KeyboardCtx.new_by_name: constructor not found for keyboard '%s'", 
                name or "nil")
            )
        end

        local params = ModCtx.__create_modctx_params(modsmgr, ...)
        local keyboard_ctx = keyboard_ctor(params)

        if not keyboard_ctx then
            error(string.format(
                "KeyboardCtx.new_by_name: failed to create keyboard instance '%s'", 
                name or "nil")
            )
        end

        return Object.__mtnew(M.__mt, ffi.cast("st_keyboardctx_t *",
            keyboard_ctx), true)
    end

    M.new = function(...)
        return M.new_by_name(nil, ...)
    end

    M.get_instance = function(module_name)
        local modsmgr = ModsMgr.get_instance()
        
        return modsmgr:get_singleton("keyboard", module_name):as("KeyboardCtx")
    end

    -- Key constants
    M.key_unknown = ffi.C.ST_KEY_UNKNOWN
    M.key_space = ffi.C.ST_KEY_SPACE
    M.key_0 = ffi.C.ST_KEY_0
    M.key_1 = ffi.C.ST_KEY_1
    M.key_2 = ffi.C.ST_KEY_2
    M.key_3 = ffi.C.ST_KEY_3
    M.key_4 = ffi.C.ST_KEY_4
    M.key_5 = ffi.C.ST_KEY_5
    M.key_6 = ffi.C.ST_KEY_6
    M.key_7 = ffi.C.ST_KEY_7
    M.key_8 = ffi.C.ST_KEY_8
    M.key_9 = ffi.C.ST_KEY_9
    M.key_a = ffi.C.ST_KEY_A
    M.key_b = ffi.C.ST_KEY_B
    M.key_c = ffi.C.ST_KEY_C
    M.key_d = ffi.C.ST_KEY_D
    M.key_e = ffi.C.ST_KEY_E
    M.key_f = ffi.C.ST_KEY_F
    M.key_g = ffi.C.ST_KEY_G
    M.key_h = ffi.C.ST_KEY_H
    M.key_i = ffi.C.ST_KEY_I
    M.key_j = ffi.C.ST_KEY_J
    M.key_k = ffi.C.ST_KEY_K
    M.key_l = ffi.C.ST_KEY_L
    M.key_m = ffi.C.ST_KEY_M
    M.key_n = ffi.C.ST_KEY_N
    M.key_o = ffi.C.ST_KEY_O
    M.key_p = ffi.C.ST_KEY_P
    M.key_q = ffi.C.ST_KEY_Q
    M.key_r = ffi.C.ST_KEY_R
    M.key_s = ffi.C.ST_KEY_S
    M.key_t = ffi.C.ST_KEY_T
    M.key_u = ffi.C.ST_KEY_U
    M.key_v = ffi.C.ST_KEY_V
    M.key_w = ffi.C.ST_KEY_W
    M.key_x = ffi.C.ST_KEY_X
    M.key_y = ffi.C.ST_KEY_Y
    M.key_z = ffi.C.ST_KEY_Z
    M.key_backspace = ffi.C.ST_KEY_BACKSPACE
    M.key_tab = ffi.C.ST_KEY_TAB
    M.key_return = ffi.C.ST_KEY_RETURN
    M.key_pause = ffi.C.ST_KEY_PAUSE
    M.key_escape = ffi.C.ST_KEY_ESCAPE
    M.key_delete = ffi.C.ST_KEY_DELETE
    M.key_home = ffi.C.ST_KEY_HOME
    M.key_left = ffi.C.ST_KEY_LEFT
    M.key_up = ffi.C.ST_KEY_UP
    M.key_right = ffi.C.ST_KEY_RIGHT
    M.key_down = ffi.C.ST_KEY_DOWN
    M.key_page_up = ffi.C.ST_KEY_PAGE_UP
    M.key_page_down = ffi.C.ST_KEY_PAGE_DOWN
    M.key_end = ffi.C.ST_KEY_END
    M.key_insert = ffi.C.ST_KEY_INSERT
    M.key_f1 = ffi.C.ST_KEY_F1
    M.key_f2 = ffi.C.ST_KEY_F2
    M.key_f3 = ffi.C.ST_KEY_F3
    M.key_f4 = ffi.C.ST_KEY_F4
    M.key_f5 = ffi.C.ST_KEY_F5
    M.key_f6 = ffi.C.ST_KEY_F6
    M.key_f7 = ffi.C.ST_KEY_F7
    M.key_f8 = ffi.C.ST_KEY_F8
    M.key_f9 = ffi.C.ST_KEY_F9
    M.key_f10 = ffi.C.ST_KEY_F10
    M.key_f11 = ffi.C.ST_KEY_F11
    M.key_f12 = ffi.C.ST_KEY_F12
    M.key_shift_l = ffi.C.ST_KEY_SHIFT_L
    M.key_shift_r = ffi.C.ST_KEY_SHIFT_R
    M.key_control_l = ffi.C.ST_KEY_CONTROL_L
    M.key_control_r = ffi.C.ST_KEY_CONTROL_R
    M.key_alt_l = ffi.C.ST_KEY_ALT_L
    M.key_alt_r = ffi.C.ST_KEY_ALT_R
    M.key_super_l = ffi.C.ST_KEY_SUPER_L
    M.key_super_r = ffi.C.ST_KEY_SUPER_R

    return M
end
