local ffi = require "ffi"
local ModCtx = require "ModCtx"
local Object = require "Object"

ffi.cdef[[
    typedef struct st_monitorctx {
        st_modctx_t __st_parent;
    } st_monitorctx_t;

    typedef struct st_monitor {
        st_object_t __st_parent;
    } st_monitor_t;

    typedef unsigned (*st_monitor_get_monitors_count_t)(
     const st_monitorctx_t *monitor_ctx);
    typedef st_monitor_t *(*st_monitor_open_t)(
     st_monitorctx_t *monitor_ctx, unsigned index);
    typedef unsigned (*st_monitor_get_width_t)(const st_monitor_t *monitor);
    typedef unsigned (*st_monitor_get_height_t)(const st_monitor_t *monitor);
    // typedef void *(*st_monitor_get_handle_t)(const st_monitor_t *monitor);
    // typedef void (*st_monitor_set_userdata_t)(const st_monitor_t *monitor,
    //  const char *key, uintptr_t value);
    // typedef bool (*st_monitor_get_userdata_t)(const st_monitor_t *monitor,
    //  uintptr_t *dst, const char *key);

    typedef struct {
        st_modctx_funcs_t             __st_parent_funcs;
        st_monitor_get_monitors_count_t get_monitors_count;
        st_monitor_open_t               open;
    } st_monitorctx_funcs_t;

    typedef struct {
        st_object_funcs_t           __st_parent_funcs;
        st_monitor_get_width_t      get_width;
        st_monitor_get_height_t     get_height;
        void                       *__get_handle;
        void                       *__set_userdata;
        void                       *__get_userdata;
    } st_monitor_funcs_t;
]]

-- Monitor context and monitor object
package.preload["MonitorCtx"] = function()
    local ModsMgr = require "ModsMgr"
    local M = {
        __ctype = "st_monitorctx_t *",
    }

    -- Internal table for monitor object wrapper
    M.__monitor = {}

    M.__monitor.methods = setmetatable({
        get_width = function(self)
            return ffi.cast("const st_monitor_funcs_t *",
                ffi.cast("st_object_t *", self.handle).funcs
            ).get_width(self.handle)
        end,

        get_height = function(self)
            return ffi.cast("const st_monitor_funcs_t *",
                ffi.cast("st_object_t *", self.handle).funcs
            ).get_height(self.handle)
        end,

        -- get_handle = function(self)
        --     return ffi.cast("const st_monitor_funcs_t *",
        --         ffi.cast("st_object_t *", self.handle).funcs
        --     ).get_handle(self.handle)
        -- end,

        -- set_userdata = function(self, key, value)
        --     ffi.cast("const st_monitor_funcs_t *",
        --         ffi.cast("st_object_t *", self.handle).funcs
        --     ).set_userdata(self.handle, key, value)
        -- end,

        -- get_userdata = function(self, key)
        --     local result = ffi.new("uintptr_t[1]")
        --     if ffi.cast("const st_monitor_funcs_t *",
        --         ffi.cast("st_object_t *", self.handle).funcs
        --     ).get_userdata(self.handle, result, key) then
        --         return tonumber(result[0])
        --     else
        --         return nil
        --     end
        -- end,
    }, { __index = Object.methods })

    M.__monitor.__mt = ffi.metatype(
        "struct { st_monitor_t *handle; bool owned; }", {
        __index = M.__monitor.methods,
        __new = function(class, handle, owned)
            return ffi.new(class, handle, owned)
        end,
        __gc = function(self)
            if self.owned then
                self:destroy()
            end
        end,
    })

    M.methods = setmetatable({
        get_monitors_count = function(self)
            return ffi.cast("const st_monitorctx_funcs_t *",
                ffi.cast("st_object_t *", self.handle).funcs
            ).get_monitors_count(self.handle)
        end,

        open = function(self, index)
            local monitor_handle = ffi.cast("const st_monitorctx_funcs_t *",
                ffi.cast("st_object_t *", self.handle).funcs
            ).open(self.handle, index)

            if monitor_handle == nil then
                error(string.format(
                    "MonitorCtx.open: failed to open monitor with index %d",
                    index)
                )
            end

            return Object.__mtnew(M.__monitor.__mt, monitor_handle, true)
        end,
    }, { __index = ModCtx.methods })

    M.__mt = ffi.metatype(
        "struct { st_monitorctx_t *handle; bool owned; }", {
        __index = M.methods,
        __new = function(class, handle, owned)
            return ffi.new(class, handle, owned)
        end,
        __gc = function(self)
            if self.owned then
                self:destroy()
            end
        end,
    })

    M.new_by_name = function(name, ...)
        local modsmgr = ModsMgr.get_instance()

        local monitor_ctor = modsmgr:get_ctor("monitor", name)
        if not monitor_ctor then
            error(string.format(
                "MonitorCtx.new_by_name: constructor not found for monitor '%s'",
                name or "nil")
            )
        end

        local params = ModCtx.__create_modctx_params(modsmgr, ...)
        local monitor_ctx = monitor_ctor(params)

        if not monitor_ctx then
            error(string.format(
                "MonitorCtx.new_by_name: failed to create monitor instance '%s'",
                name or "nil")
            )
        end

        return Object.__mtnew(M.__mt, ffi.cast("st_monitorctx_t *",
            monitor_ctx), true)
    end

    M.new = function(...)
        return M.new_by_name(nil, ...)
    end

    M.get_instance = function(module_name)
        local modsmgr = ModsMgr.get_instance()
        
        return modsmgr:get_singleton("monitor", module_name):as("MonitorCtx")
    end

    return M
end

