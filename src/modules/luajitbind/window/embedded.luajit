local ffi = require "ffi"

local ModCtx     = require "ModCtx"
local MonitorCtx = require "MonitorCtx"
local Object     = require "Object"

ffi.cdef[[
    typedef struct st_windowctx {
        st_modctx_t __st_parent;
    } st_windowctx_t;

    typedef struct st_window {
        st_object_t __st_parent;
    } st_window_t;

    typedef st_window_t *(*st_window_create_t)(st_windowctx_t *window_ctx,
     st_monitor_t *monitor, int x, int y, unsigned width, unsigned height,
     bool fullscreen, const char *title);
    typedef void (*st_window_process_t)(st_windowctx_t *window_ctx);
    typedef bool (*st_window_xed_t)(const st_window_t *window);
    typedef st_monitor_t *(*st_window_get_monitor_t)(const st_window_t *window);
    // typedef void *(*st_window_get_handle_t)(const st_window_t *window);
    typedef unsigned (*st_window_get_width_t)(const st_window_t *window);
    typedef unsigned (*st_window_get_height_t)(const st_window_t *window);

    typedef struct {
        st_modctx_funcs_t     __st_parent_funcs;
        st_window_create_t    create;
        st_window_process_t   process;
    } st_windowctx_funcs_t;

    typedef struct {
        st_object_funcs_t         __st_parent_funcs;
        st_window_xed_t           xed;
        st_window_get_monitor_t   get_monitor;
        void                     *__get_handle;
        st_window_get_width_t     get_width;
        st_window_get_height_t    get_height;
    } st_window_funcs_t;
]]

-- Window context and window object
package.preload["WindowCtx"] = function()
    local ModsMgr = require "ModsMgr"
    local M = {
        __ctype = "st_windowctx_t *",
    }

    -- Internal table for window object wrapper
    M.__window = {}

    M.__window.methods = setmetatable({
        xed = function(self)
            return ffi.cast("const st_window_funcs_t *",
                ffi.cast("st_object_t *", self.handle).funcs
            ).xed(self.handle)
        end,

        get_monitor = function(self)
            local monitor_handle = ffi.cast("const st_window_funcs_t *",
                ffi.cast("st_object_t *", self.handle).funcs
            ).get_monitor(self.handle)

            if monitor_handle == nil then
                error(
                 "WindowCtx.get_monitor: failed to get monitor from window")
            end

            -- Create wrapper with owned=false since monitor_ctx owns the 
            -- monitor object
            return Object.__mtnew(MonitorCtx.__monitor.__mt, monitor_handle, 
             false)
        end,

        -- get_handle = function(self)
        --     return ffi.cast("const st_window_funcs_t *",
        --         ffi.cast("st_object_t *", self.handle).funcs
        --     ).get_handle(self.handle)
        -- end,

        get_width = function(self)
            return ffi.cast("const st_window_funcs_t *",
                ffi.cast("st_object_t *", self.handle).funcs
            ).get_width(self.handle)
        end,

        get_height = function(self)
            return ffi.cast("const st_window_funcs_t *",
                ffi.cast("st_object_t *", self.handle).funcs
            ).get_height(self.handle)
        end,
    }, { __index = Object.methods })

    M.__window.__mt = ffi.metatype(
        "struct { st_window_t *handle; bool owned; }", {
        __index = M.__window.methods,
        __new = function(class, handle, owned)
            return ffi.new(class, handle, owned)
        end,
        __gc = function(self)
            if self.owned then
                self:destroy()
            end
        end,
    })

    M.methods = setmetatable({
        create = function(self, monitor, x, y, width, height, fullscreen, title)
            local window_handle = ffi.cast("const st_windowctx_funcs_t *",
                ffi.cast("st_object_t *", self.handle).funcs
            ).create(self.handle, monitor.handle, x, y, width, height,
             fullscreen, title)

            if window_handle == nil then
                error("WindowCtx.create: failed to create window")
            end

            return Object.__mtnew(M.__window.__mt, window_handle, true)
        end,

        process = function(self)
            ffi.cast("const st_windowctx_funcs_t *",
                ffi.cast("st_object_t *", self.handle).funcs
            ).process(self.handle)
        end,
    }, { __index = ModCtx.methods })

    M.__mt = ffi.metatype(
        "struct { st_windowctx_t *handle; bool owned; }", {
        __index = M.methods,
        __new = function(class, handle, owned)
            return ffi.new(class, handle, owned)
        end,
        __gc = function(self)
            if self.owned then
                self:destroy()
            end
        end,
    })

    M.new_by_name = function(name, ...)
        local modsmgr = ModsMgr.get_instance()

        local window_ctor = modsmgr:get_ctor("window", name)
        if not window_ctor then
            error(string.format(
                "WindowCtx.new_by_name: constructor not found for window '%s'",
                name or "nil")
            )
        end

        local params = ModCtx.__create_modctx_params(modsmgr, ...)
        local window_ctx = window_ctor(params)

        if not window_ctx then
            error(string.format(
                "WindowCtx.new_by_name: failed to create window instance '%s'",
                name or "nil")
            )
        end

        return Object.__mtnew(M.__mt, ffi.cast("st_windowctx_t *",
            window_ctx), true)
    end

    M.new = function(...)
        return M.new_by_name(nil, ...)
    end

    M.get_instance = function(module_name)
        local modsmgr = ModsMgr.get_instance()
        
        return modsmgr:get_singleton("window", module_name):as("WindowCtx")
    end

    return M
end


