[settings]
os=Linux
arch=x86_64
compiler=gcc
compiler.version=7
compiler.libcxx=libstdc++11
build_type=Release

[platform_tool_requires]
m4/*
autoconf/*
automake/*
bison/*
flex/*
libtool/*
ninja/*
yasm/*
cmake/*
meson/*
pkgconf/*

[conf]
tools.system.package_manager:sudo=False
